# production (Pflicht-Variablen werden geprueft) oder test (nur E2E, mit READER=fake)
NODE_ENV=production
# 1 = Cookies ohne Secure (nur lokal ueber http)
INSECURE_COOKIES=
# HTTP-Port der App
PORT=12080
# Oeffentliche URL (Tunnel), z. B. https://marbles.example.org
PUBLIC_URL=
# Datenverzeichnis (SQLite, Backups) = Named Volume app-data; Backups liegen unter /data/backups und gehen zusaetzlich nach R2; Kopie: docker compose cp app:/data/backups ./backups
DATA_DIR=/data
# Geheimer Schluessel fuer Session-Cookies (zufaellig, lang)
SESSION_SECRET=
# Twitch-App Zugangsdaten
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch-Endpunkte (nur fuer Tests/Fakes aendern)
TWITCH_AUTH_BASE=https://id.twitch.tv
TWITCH_HELIX_BASE=https://api.twitch.tv/helix
# Twitch-User-ID des Admins
ADMIN_TWITCH_USER_ID=
# ntfy-Topic-URL und Token fuer Admin-Alarme
ADMIN_NTFY_URL=
ADMIN_NTFY_TOKEN=
# Oeffentliche Basis-URL des ntfy-Servers (auch fuer ntfy/server.yml)
NTFY_BASE_URL=
# ntfy-Publisher: Token (tk_ + 29 Zeichen, `ntfy token generate`) und bcrypt-Hash (`ntfy user hash`), in einfache Anfuehrungszeichen setzen
NTFY_APP_TOKEN=
NTFY_MARBLE_PASS_HASH=
# Limits (optional, sonst Standardwerte)
MAX_ACCOUNTS=100
MAX_CHANNELS_TOTAL=50
MAX_CHANNELS_PER_USER=10
# Chat-Reader: twurple oder fake
READER=twurple
# Cloudflare R2 fuer Backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Cloudflare-Tunnel-Token
TUNNEL_TOKEN=
