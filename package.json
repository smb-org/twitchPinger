{
  "name": "marble-notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "dev:api": "node --watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "e2e": "playwright test",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@twurple/chat": "^8.2.0",
    "hono": "^4.13.13",
    "re2js": "^2.8.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "preact": "^11.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
